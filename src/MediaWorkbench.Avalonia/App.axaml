<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaWorkbench.Avalonia.App"
             RequestedThemeVariant="Dark">
    <!-- "Night glass": deep navy under the Windows backdrop, frosted panels with a light edge, one clear blue accent, Inter for
         the interface and Cascadia Mono for numbers. Colours, fonts, icons and control styles are all in Theme.axaml; this
         palette only gives Fluent's own parts (check marks, scroll bars, focus rings) the same colours. -->
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#3D86FA" AltHigh="#0B1529" AltLow="#0B1529" AltMedium="#0B1529" AltMediumHigh="#0B1529" AltMediumLow="#0B1529"
                                       BaseHigh="#F1F5FC" BaseLow="#273A5E" BaseMedium="#B6C4DD" BaseMediumHigh="#D3DDEE" BaseMediumLow="#94A5C4"
                                       ChromeAltLow="#D3DDEE" ChromeBlackHigh="#000000" ChromeBlackLow="#D3DDEE" ChromeBlackMedium="#000000" ChromeBlackMediumLow="#000000"
                                       ChromeDisabledHigh="#273A5E" ChromeDisabledLow="#94A5C4" ChromeGray="#93A3C2" ChromeHigh="#93A3C2" ChromeLow="#0F1A31"
                                       ChromeMedium="#1B2B4B" ChromeMediumLow="#20325A" ChromeWhite="#FFFFFF" ListLow="#1B2B4B" ListMedium="#273A5E"
                                       RegionColor="#0B1529" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://MediaWorkbench.Avalonia/Theme.axaml" />
    </Application.Styles>
</Application>
