<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MediaWorkbench.Avalonia">
    <Styles.Resources>
        <!-- "Night glass": deep navy under the Windows backdrop, panels of frosted glass with a light top edge, one clear blue
             accent. Brushes read by the drawn controls (through Tokens.Brush) must stay plain colours; only the window and panel
             fills are gradients. -->

        <!-- Surfaces, from the window up. -->
        <LinearGradientBrush x:Key="WindowTint" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#F2101D38" />
            <GradientStop Offset="0.55" Color="#F50B1529" />
            <GradientStop Offset="1" Color="#F8070E1D" />
        </LinearGradientBrush>
        <!-- A faint blue light from the top left, so the glass has something to catch. -->
        <RadialGradientBrush x:Key="WindowGlow" Center="12%,0%" GradientOrigin="12%,0%" RadiusX="70%" RadiusY="90%">
            <GradientStop Offset="0" Color="#2E3F8CFF" />
            <GradientStop Offset="1" Color="#003F8CFF" />
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#C41A2A4C" />
            <GradientStop Offset="1" Color="#B8111D38" />
        </LinearGradientBrush>
        <!-- The glass edge: bright where light would hit the top, fading down the sides. -->
        <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#40B9D4FF" />
            <GradientStop Offset="0.35" Color="#1AB9D4FF" />
            <GradientStop Offset="1" Color="#0DB9D4FF" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="GlassFillBrush" Color="#E6152443" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0F1A31" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1B2B4B" />
        <SolidColorBrush x:Key="HoverBrush" Color="#25385E" />
        <SolidColorBrush x:Key="PressedBrush" Color="#2D446F" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#2B4677" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#273A5E" />
        <SolidColorBrush x:Key="ControlEdgeBrush" Color="#22B9D4FF" />
        <SolidColorBrush x:Key="StageBrush" Color="#050A16" />
        <!-- The WPF app's backdrop for a "transparent" stitch saved as JPEG: exported files keep it, whatever the theme. -->
        <SolidColorBrush x:Key="MonitorBrush" Color="#04060E" />
        <!-- Text: three steps, each at least 4.5:1 on the panels and on a hovered row (Faint gives way to Secondary on a
             selected row, where the fill is brighter). -->
        <SolidColorBrush x:Key="InkBrush" Color="#F1F5FC" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#B6C4DD" />
        <SolidColorBrush x:Key="FaintBrush" Color="#94A5C4" />
        <!-- The accent: a clear azure for lines and text on the dark, a deeper blue fill with white text for buttons. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5CABFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#8CC5FF" />
        <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#385CABFF" />
        <SolidColorBrush x:Key="AccentFaintBrush" Color="#1C5CABFF" />
        <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#2F6DE8" />
            <GradientStop Offset="1" Color="#1D4FC4" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentFillHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#3474EC" />
            <GradientStop Offset="1" Color="#2257D0" />
        </LinearGradientBrush>
        <!-- Meanings. -->
        <SolidColorBrush x:Key="FavoriteBrush" Color="#FFD166" />
        <SolidColorBrush x:Key="TagBrush" Color="#C7B8FF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4FE0A0" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF7D8C" />
        <SolidColorBrush x:Key="PhotoBrush" Color="#A993FF" />
        <SolidColorBrush x:Key="VideoBrush" Color="#5FD0FF" />
        <SolidColorBrush x:Key="AudioBrush" Color="#4FE0A0" />

        <FontFamily x:Key="MonoFont">avares://MediaWorkbench.Avalonia/Assets/Fonts#Cascadia Mono</FontFamily>
        <CornerRadius x:Key="CardRadius">14</CornerRadius>
        <CornerRadius x:Key="ControlRadius">10</CornerRadius>
        <CornerRadius x:Key="PanelRadius">18</CornerRadius>
        <BoxShadows x:Key="PanelShadow">0 14 36 0 #59020612</BoxShadows>
        <BoxShadows x:Key="FloatShadow">0 10 28 0 #73020612</BoxShadows>

        <!-- Fluent's own controls, in the same glass: text boxes, drop-downs, menus, tooltips, sections, tabs, sliders. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#B30C1730" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#CC13213F" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E60A142B" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#660C1730" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E4370" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3F5A8E" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5CABFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1E2D4D" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F1F5FC" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F1F5FC" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#94A5C4" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#94A5C4" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#94A5C4" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#B30C1730" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#CC13213F" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E6182A4E" />
        <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#B30C1730" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#660C1730" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E4370" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3F5A8E" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#5CABFF" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ComboBoxPlaceHolderForeground" Color="#94A5C4" />
        <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#B6C4DD" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5122142" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#33B9D4FF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#25385E" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#2D446F" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#385CABFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#4A5CABFF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#5A5CABFF" />
        <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#F1F5FC" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F5122142" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#33B9D4FF" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#25385E" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2D446F" />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F5122142" />
        <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#33B9D4FF" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="#F7152648" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#33B9D4FF" />
        <SolidColorBrush x:Key="ToolTipForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#14B9D4FF" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#1FB9D4FF" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#B6C4DD" />
        <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="#F1F5FC" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#B6C4DD" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#F1F5FC" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#F1F5FC" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#5CABFF" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#2E4370" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#3F5A8E" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#5CABFF" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#8CC5FF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#5CABFF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#8CC5FF" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#3D7CF2" />
        <SolidColorBrush x:Key="CheckBoxBorderBrushUnchecked" Color="#5A6E96" />
        <SolidColorBrush x:Key="CheckBoxBorderBrushUncheckedPointerOver" Color="#94A5C4" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#3D86FA" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#5CABFF" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />

        <!-- Icons: line shapes (Path.line) and filled shapes (PathIcon) on a 16-unit grid, drawn with the text colour. -->
        <StreamGeometry x:Key="IconPlay">M5,3 L13,8 L5,13 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M4,3 H7 V13 H4 Z M9,3 H12 V13 H9 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStepBack">M3,3 H5 V13 H3 Z M13,3 V13 L6,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStepForward">M11,3 H13 V13 H11 Z M3,3 L10,8 L3,13 Z</StreamGeometry>
        <StreamGeometry x:Key="IconRestart">M3,3 H5 V13 H3 Z M14,3 V13 L9,8 Z M9,3 V13 L4.5,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M1.5,3.5 H6 L7.5,5 H14.5 V13 H1.5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolderFill">M1,3 H6 L7.5,4.5 H15 V13.5 H1 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M3,1.6 L8,6.6 L13,1.6 L14.4,3 L9.4,8 L14.4,13 L13,14.4 L8,9.4 L3,14.4 L1.6,13 L6.6,8 L1.6,3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconStar">M8,1 L10.1,5.6 L15,6.1 L11.3,9.4 L12.4,14.3 L8,11.8 L3.6,14.3 L4.7,9.4 L1,6.1 L5.9,5.6 Z</StreamGeometry>
        <StreamGeometry x:Key="IconImage">M1,2 H15 V14 H1 Z M3,4 V10 L6,7 L9,10 L11,8 L13,10 V4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSidebar">M1.5,2.5 H14.5 V13.5 H1.5 Z M5.5,2.5 V13.5</StreamGeometry>
        <StreamGeometry x:Key="IconInspector">M1.5,2.5 H14.5 V13.5 H1.5 Z M10.5,2.5 V13.5</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M7,2.5 A4.5,4.5 0 1 1 6.99,2.5 Z M10.2,10.2 L14,14</StreamGeometry>
        <StreamGeometry x:Key="IconFit">M2.5,6 V2.5 H6 M10,2.5 H13.5 V6 M13.5,10 V13.5 H10 M6,13.5 H2.5 V10</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.5,4.5 M11.5,1.5 V4.5 H8.5</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M8,5.5 A2.5,2.5 0 1 1 7.99,5.5 Z M8,1.5 V3.5 M8,12.5 V14.5 M1.5,8 H3.5 M12.5,8 H14.5 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M3.4,12.6 L4.8,11.2 M11.2,4.8 L12.6,3.4</StreamGeometry>
        <!-- Chevrons for the folder tree and its open-all / close-all buttons (10-unit grid). -->
        <StreamGeometry x:Key="IconChevronRight">M3.5,1.5 L7,5 L3.5,8.5</StreamGeometry>
        <StreamGeometry x:Key="IconChevronDown">M1.5,3.5 L5,7 L8.5,3.5</StreamGeometry>
        <StreamGeometry x:Key="IconExpandAll">M1.5,1.5 L5,5 L8.5,1.5 M1.5,5 L5,8.5 L8.5,5</StreamGeometry>
        <StreamGeometry x:Key="IconCollapseAll">M1.5,1.5 L5,5 L1.5,8.5 M5,1.5 L8.5,5 L5,8.5</StreamGeometry>

        <!-- Messages at the bottom right of the centre view. -->
        <DataTemplate x:Key="NotificationTemplate" x:DataType="local:Notification">
            <Border Classes="toast" Margin="0,8,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="2" Margin="0,0,12,0" Classes="notificationMark" Classes.error="{Binding IsError}" Classes.success="{Binding IsSuccess}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding ActionLabel}" Command="{Binding $parent[Window].((local:MainViewModel)DataContext).RunNotificationActionCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasAction}" />
                        <Button Classes="quiet" Command="{Binding $parent[Window].((local:MainViewModel)DataContext).DismissNotificationCommand}" CommandParameter="{Binding}" ToolTip.Tip="Dismiss"><PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" /></Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="80" FontSize="12.5" Foreground="{StaticResource InkBrush}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Styles.Resources>

    <!-- The title bar Avalonia draws keeps its window buttons, but not its own copy of the title: the top bar shows the name. -->
    <Style Selector="WindowDrawnDecorations TextBlock">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Kept in place but not seen or clicked: parts that come and go without moving their neighbours. -->
    <Style Selector=":is(Control).hidden">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Type. -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>
    <!-- A place name above a heading (the overview's folder): the accent colour, kept in the folder's own case. -->
    <Style Selector="TextBlock.crumb">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>

    <!-- Panels: frosted glass on the navy, with a light top edge and a soft shadow underneath. -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
        <Setter Property="BoxShadow" Value="{StaticResource PanelShadow}" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <!-- Where the picture sits: near black, rounded, with the same faint edge so it reads as set into the glass. -->
    <Style Selector="Border.stage">
        <Setter Property="Background" Value="{StaticResource StageBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,3" />
    </Style>
    <Style Selector="Border.chip.accent">
        <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
    </Style>
    <Style Selector="Border.chip.tag">
        <Setter Property="Background" Value="#26C7B8FF" />
    </Style>
    <Style Selector="Border.tagChip">
        <Setter Property="Background" Value="#1FC7B8FF" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="10,2,2,2" />
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Border.tagChip.accent">
        <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
    </Style>
    <Style Selector="Border.floating">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BoxShadow" Value="{StaticResource FloatShadow}" />
    </Style>
    <Style Selector="Border.floating.accent">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.floatingBar">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BoxShadow" Value="{StaticResource FloatShadow}" />
    </Style>
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BoxShadow" Value="{StaticResource FloatShadow}" />
    </Style>
    <Style Selector="Border.notificationMark">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Border.notificationMark.error">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.notificationMark.success">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.callout">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="BoxShadow" Value="0 16 40 0 #8C020612" />
    </Style>
    <!-- A row of view switches sitting in a shallow rounded track. -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="#14B9D4FF" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Icons inside buttons take the button's text colour. -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Path.line">
        <Setter Property="Stroke" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
    </Style>
    <Style Selector="Button:pointerover Path.line">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
    </Style>
    <!-- Small chevrons: the folder tree's open/close arrow turns a quarter when the folder opens. -->
    <Style Selector="Path.chevron">
        <Setter Property="Stroke" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="Path.chevron.open">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Border.treeToggle:pointerover Path.chevron, Button:pointerover Path.chevron">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Border.treeToggle">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.treeToggle:pointerover">
        <Setter Property="Background" Value="#1FB9D4FF" />
    </Style>

    <!-- Buttons: soft glass fills with a faint edge, a brighter one on hover, everything eased. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="#33B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
        <Setter Property="BorderBrush" Value="#33B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#990F1A31" />
        <Setter Property="BorderBrush" Value="#12B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>
    <Style Selector="Button.active">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- Buttons that are only an icon or a word on the glass: no fill or edge until hovered. -->
    <Style Selector="Button.icon, Button.quiet, Button.ghost, Button.row, Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="Button.quiet">
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.quiet.small">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="Button.row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <!-- The one main action in a place (export): a deeper blue with white text and a soft blue glow. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="#4DB9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Effect">
            <DropShadowEffect OffsetX="0" OffsetY="3" BlurRadius="14" Color="#3D86FA" Opacity="0.45" />
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentFillHoverBrush}" />
        <Setter Property="BorderBrush" Value="#66B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentFaintBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>
    <Style Selector="Button.floatingButton">
        <Setter Property="Background" Value="{StaticResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
    </Style>
    <Style Selector="Button.star.on">
        <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
    </Style>
    <Style Selector="Button.star.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
    </Style>
    <!-- The big round play button. -->
    <Style Selector="Button.play">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="{StaticResource AccentFillBrush}" />
        <Setter Property="BorderBrush" Value="#4DB9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
        <Setter Property="Effect">
            <DropShadowEffect OffsetX="0" OffsetY="4" BlurRadius="18" Color="#3D86FA" Opacity="0.55" />
        </Setter>
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentFillHoverBrush}" />
        <Setter Property="BorderBrush" Value="#66B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
    </Style>
    <!-- A folder in the overview: covers on top, name and count underneath; lifts a little on hover. -->
    <Style Selector="Button.folderCard">
        <Setter Property="Width" Value="184" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="Button.folderCard:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-3px)" />
    </Style>
    <Style Selector="Button.folderCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.folderCard:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <!-- Chips that turn on and off: tag filters and favorites only. Fully round. -->
    <Style Selector="ToggleButton.chip">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="#33B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="#665CABFF" />
        <Setter Property="Foreground" Value="#DCEBFF" />
    </Style>
    <Style Selector="ToggleButton.chip.star">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.chip.star:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
        <Setter Property="Background" Value="#26FFD166" />
        <Setter Property="BorderBrush" Value="#4DFFD166" />
    </Style>

    <!-- The centre views: pills in a shallow track, the open one lit. -->
    <Style Selector="RadioButton.viewTab">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Pill" Background="{TemplateBinding Background}" CornerRadius="9" Padding="14,5">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="RadioButton.viewTab:pointerover">
        <Setter Property="Background" Value="#1FB9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="RadioButton.viewTab:checked">
        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Inspector tabs: text tabs with a short blue line under the open one. -->
    <Style Selector="TabControl.inspector TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TabControl.inspector TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Lists: rounded rows, a soft fill on hover, a blue pill when chosen. -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem, ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="0,0,6,2" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#17B9D4FF" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.folderName">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="TextBlock.folderName.workspace">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.folderName.all">
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.count">
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:pointerover TextBlock.count, ListBox.tree ListBoxItem:selected TextBlock.count">
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.tree ListBoxItem:selected TextBlock.folderName">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Folder tabs over the filmstrip: small round pills. -->
    <Style Selector="ListBox.folderTabs ListBoxItem">
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="ListBox.folderTabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.folderTabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#17B9D4FF" />
    </Style>
    <Style Selector="ListBox.folderTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
    </Style>
    <Style Selector="ListBox.folderTabs ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Filmstrip cards: a soft lift on hover, a blue ring and glow when chosen. -->
    <Style Selector="ListBox.filmstrip">
        <Setter Property="Padding" Value="0,4,0,0" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="RenderTransform" Value="translateY(0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:pointerover">
        <Setter Property="RenderTransform" Value="translateY(-3px)" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem Border.thumbCard">
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:pointerover Border.thumbCard">
        <Setter Property="BorderBrush" Value="#40B9D4FF" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:selected Border.thumbCard">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- The glow is on the frame around the card: the card itself clips to its round corners, which would cut a shadow off. -->
    <Style Selector="ListBox.filmstrip ListBoxItem:selected Border.thumbGlow">
        <Setter Property="BoxShadow" Value="0 0 16 0 #665CABFF" />
    </Style>
    <!-- Thumbnails fade in once they arrive instead of popping. -->
    <Style Selector="Image.thumb">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Image.thumb.ready">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Inputs: rounder than Fluent's, colours from the resources above. -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="SelectionBrush" Value="#665CABFF" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="17" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="4,1" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Sections that fold: a calm header in sentence case, no box around them. -->
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#1FB9D4FF" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- Picking and choosing tags (after the general button styles, so these win). -->
    <!-- A tag only some of the picked files carry: an outline instead of a fill. -->
    <Style Selector="Border.tagChip.partial">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#59C7B8FF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Picking files in the filmstrip: a round mark on each thumbnail (shown on hover, or on all of them once something is
         picked), a blue wash on a picked card, and a bar over the filmstrip saying what is picked. -->
    <Style Selector="Button.pickMark">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="#99050A16" />
        <Setter Property="BorderBrush" Value="#CCF1F5FC" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.pickMark Path.tick">
        <Setter Property="Stroke" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.filmstrip ListBoxItem:pointerover Button.pickMark, ListBox.filmstrip.picking Button.pickMark, Button.pickMark.picked">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.pickMark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#CC1B2B4B" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.pickMark.picked">
        <Setter Property="Background" Value="#3D86FA" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.pickMark.picked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3D86FA" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.pickMark.picked Path.tick">
        <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.pickWash">
        <Setter Property="Background" Value="#335CABFF" />
    </Style>
    <Style Selector="Border.pickBar">
        <Setter Property="Background" Value="{StaticResource AccentFaintBrush}" />
        <Setter Property="BorderBrush" Value="#4D5CABFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Path.tick">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tag bubbles: each tag in its own pastel (TagColors), filled when it is on what is being tagged, a faint wash of it when
         not, an outline when only some of the picked files have it. Hover keeps the colour and lifts the bubble a little. -->
    <Style Selector="Button.tagBubble">
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.tagBubble.some">
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tagBubble:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.tagBubble:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.tagBubble:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <Style Selector="Button.tagBubble:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.tagBubble:disabled">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.tagBubble Path.tick">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <!-- On a filled pastel bubble, its × is dark like its text. -->
    <Style Selector="Border.tagChip.pastel Button.quiet">
        <Setter Property="Foreground" Value="#131B30" />
    </Style>
    <Style Selector="Border.tagChip.pastel Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26000000" />
        <Setter Property="Foreground" Value="#131B30" />
    </Style>
    <!-- A tag box that fits a 32-high row (the bar over the filmstrip). -->
    <Style Selector="AutoCompleteBox.compact TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

    <!-- A full-width switch that opens a section under it. -->
    <Style Selector="ToggleButton.disclosure">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        <Setter Property="BorderBrush" Value="#33B9D4FF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
        <Setter Property="BorderBrush" Value="#665CABFF" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button.small">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- The Graph tab: a glass card beside the map and glass buttons over it, a touch deeper and more violet than the panels. -->
    <Style Selector="Border.graphCard">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#C2231B55" />
                <GradientStop Offset="1" Color="#B80D1636" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="BoxShadow" Value="0 18 44 0 #8C02040F" />
    </Style>
    <Style Selector="Button.graphGlass">
        <Setter Property="Background" Value="#B3181E48" />
        <Setter Property="BorderBrush" Value="#40B9D4FF" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="AutoCompleteBox.graphGlass TextBox">
        <Setter Property="Background" Value="#B3181E48" />
        <Setter Property="BorderBrush" Value="#40B9D4FF" />
    </Style>
    <Style Selector="Button.graphRow">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="-8,0,0,2" />
    </Style>
    <Style Selector="Button.graphRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#1FB9D4FF" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</Styles>
