<Window x:Class="MediaWorkbench.App.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MediaWorkbench.ico" Title="Media Workbench - startup check" Style="{StaticResource DarkWindowStyle}" ThemeMode="Dark"
        Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" Background="{StaticResource CanvasBrush}">
        <TextBlock Text="Could not start Media Workbench" FontSize="20" Margin="0,0,0,16" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxHeight="300" />
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
