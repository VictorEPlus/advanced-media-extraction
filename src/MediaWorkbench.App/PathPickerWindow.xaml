<Window x:Class="MediaWorkbench.App.PathPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}" ThemeMode="Dark"
        Width="820" Height="600" MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Instruction" FontSize="16" Margin="0,0,0,12" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="Drives" Click="ShowDrives" />
            <Button DockPanel.Dock="Left" Content="Up" Click="GoUp" />
            <Button DockPanel.Dock="Right" Content="Go" Click="GoToAddress" />
            <TextBox x:Name="Address" Margin="0,0,8,6" KeyDown="AddressKeyDown" AutomationProperties.Name="Folder path" />
        </DockPanel>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6">
            <ListBox x:Name="Entries" MouseDoubleClick="OpenEntry" KeyDown="EntryKeyDown" SelectionChanged="EntrySelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Folders and files">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,6" ToolTip="{Binding FullPath}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" Width="65" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel x:Name="SaveOptions" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="Filename" />
            <TextBox x:Name="FileName" Text="favorites.json" TextChanged="FileNameChanged" AutomationProperties.Name="Favorites filename" />
            <CheckBox x:Name="Overwrite" Content="Replace an existing file with this name" />
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Choose" Content="Select" Click="ChoosePath" Style="{StaticResource AccentButton}" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
