<Window x:Class="MediaWorkbench.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MediaWorkbench.App"
        Style="{StaticResource DarkWindowStyle}" ThemeMode="Dark"
        Icon="Assets/MediaWorkbench.ico" Title="Media Workbench" Width="1500" Height="940" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown" Closed="OnClosed" SizeChanged="OnWindowSizeChanged"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}" />
        <Style TargetType="ProgressBar" BasedOn="{StaticResource AppProgressBar}" />
        <Style TargetType="Slider" BasedOn="{StaticResource AppSlider}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}" />
        <!-- This window's ThemeMode merges the Windows 11 styles into its own resources, so every control the app restyles is repeated here. -->
        <Style TargetType="Expander" BasedOn="{StaticResource AppExpander}" />
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource AppScrollViewer}" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBar}" />
        <Style TargetType="ContextMenu" BasedOn="{StaticResource AppContextMenu}" />
        <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}" />
        <Style TargetType="Separator" BasedOn="{StaticResource AppSeparator}" />
        <Style TargetType="ToolTip" BasedOn="{StaticResource AppToolTip}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource AppListBox}" />
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MediaListItem}" />
        <!-- Inspector tabs: monospace capitals, a lit line under the open one. -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource InkBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel IsItemsHost="True" Orientation="Horizontal" /></Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="0,10,0,0" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- The centre views. Radio buttons rather than a TabControl, so the preview keeps its state while another view is open. -->
        <Style x:Key="MainTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,0" Height="34">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource InkBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource InkBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- Folder tabs over the filmstrip. -->
        <Style x:Key="FolderTabItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Tab" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" Padding="10,0,4,0" Height="26" Margin="0,0,4,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Tab" Property="Background" Value="{StaticResource SelectedBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Readout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="ListRowButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        </Style>
        <!-- Messages at the bottom right of the centre view. -->
        <DataTemplate x:Key="NotificationTemplate">
            <Border Background="#F2131A38" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" Padding="10,6" Margin="0,6,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" Margin="0,0,10,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource AccentBrush}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Background" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Background" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                    </Border>
                    <local:SpacedPanel DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.RunNotificationActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasAction, Converter={StaticResource BoolVisibility}}" />
                        <Button Content="&#x2715;" Style="{StaticResource IconButton}" Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Dismiss" />
                    </local:SpacedPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="80" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /></Grid.RowDefinitions>

        <!-- Top bar: panels on/off at the ends, the filter in the middle, workspace-wide actions on the right. -->
        <ContentControl x:Name="HeaderBar" Style="{StaticResource GlassPanel}" Margin="8,8,8,0" Padding="8,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <local:SpacedPanel Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="SourcesButton" Style="{StaticResource IconButton}" Command="{Binding ToggleSourcesCommand}" ToolTip="Show or hide the workspace panel" AutomationProperties.Name="Workspace panel">
                        <Path Data="M 0.5,0.5 H 15.5 V 12.5 H 0.5 Z M 5.5,0.5 V 12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <TextBlock Text="MEDIA//WORKBENCH" Style="{StaticResource PanelTitle}" FontSize="13" Margin="0,0,6,0" />
                </local:SpacedPanel>
                <Grid x:Name="FilterBar" Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Search file names and subfolders in the workspace" AutomationProperties.Name="Search media" Padding="26,0,30,0" />
                    <TextBlock Text="&#x2315;" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center" Margin="9,0,0,1" IsHitTestVisible="False" />
                    <Button x:Name="ClearFiltersButton" Style="{StaticResource QuietIconButton}" Content="&#x2715;" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolHidden}}" ToolTip="Clear the search and every filter" AutomationProperties.Name="Clear filters" />
                    <local:SpacedPanel Grid.Column="1" Margin="6,0,0,0">
                        <ComboBox x:Name="MediaFilterBox" Width="112" ItemsSource="{Binding MediaFilters}" SelectedItem="{Binding MediaFilter}" AutomationProperties.Name="Media type filter" ToolTip="Which kinds of file to show" />
                        <ComboBox x:Name="SortBox" Width="156" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMethod}" AutomationProperties.Name="Sort media" ToolTip="The order of the filmstrip" />
                        <ToggleButton x:Name="FavoritesOnlyBox" Style="{StaticResource ToggleChip}" Content="&#x2605;" IsChecked="{Binding FavoritesOnly}" ToolTip="Show favorites only" AutomationProperties.Name="Favorites only" />
                    </local:SpacedPanel>
                </Grid>
                <local:SpacedPanel Grid.Column="2">
                    <Button x:Name="RescanButton" Style="{StaticResource IconButton}" Content="&#x21BB;" Command="{Binding RescanCommand}" ToolTip="Check the workspace folders for added, changed or removed files" AutomationProperties.Name="Rescan" />
                    <Button x:Name="OpenExportsButton" Click="OutputMenuClicked" ToolTip="{Binding ExportDestination}" AutomationProperties.Name="Output folder">
                        <TextBlock MaxWidth="190" TextTrimming="CharacterEllipsis"><Run Text="OUT" Foreground="{StaticResource MutedBrush}" /><Run Text=" " /><Run Text="{Binding ExportFolderName, Mode=OneWay}" /><Run Text=" &#x25BE;" Foreground="{StaticResource AccentBrush}" /></TextBlock>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open the output folder" Command="{Binding OpenExportsCommand}" />
                                <MenuItem x:Name="ChangeOutputButton" Header="Change the output folder&#x2026;" Command="{Binding ChangeExportDirectoryCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#x2699;" Command="{Binding ShowSettingsCommand}" ToolTip="Advanced settings" AutomationProperties.Name="Settings" />
                    <Button x:Name="TourButton" Style="{StaticResource IconButton}" Content="?" Command="{Binding StartTourCommand}" ToolTip="Tour the UI: a walk through every panel and button" AutomationProperties.Name="Tour the UI" />
                    <Button x:Name="InspectorButton" Style="{StaticResource IconButton}" Command="{Binding ToggleInspectorCommand}" ToolTip="Show or hide the inspector panel" AutomationProperties.Name="Inspector panel">
                        <Path Data="M 0.5,0.5 H 15.5 V 12.5 H 0.5 Z M 10.5,0.5 V 12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </local:SpacedPanel>
            </Grid>
        </ContentControl>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigatorColumn" Width="270" MinWidth="220" MaxWidth="420" /><ColumnDefinition x:Name="NavigatorGap" Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorGap" Width="8" /><ColumnDefinition x:Name="InspectorColumn" Width="330" MinWidth="300" MaxWidth="460" /></Grid.ColumnDefinitions>

            <!-- Workspace: every folder that is open, each with its own tree. Clicking a folder shows it in the filmstrip; nothing is rescanned. -->
            <ContentControl x:Name="SourcesPanel" Style="{StaticResource GlassPanel}" Padding="10,10,4,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,8">
                        <local:SpacedPanel DockPanel.Dock="Right" Spacing="2">
                            <Button x:Name="ExpandFoldersButton" Style="{StaticResource QuietIconButton}" Content="&#x25BE;" Command="{Binding ExpandAllFoldersCommand}" ToolTip="Open every folder in the tree" />
                            <Button x:Name="CollapseFoldersButton" Style="{StaticResource QuietIconButton}" Content="&#x25B8;" Command="{Binding CollapseAllFoldersCommand}" ToolTip="Close every folder in the tree" />
                            <Button x:Name="OpenFolderButton" Style="{StaticResource GhostButton}" Content="+ ADD" Command="{Binding OpenFolderCommand}" Margin="6,0,0,0" ToolTip="Add a folder to the workspace. The folders already open stay open. You can also drop a folder onto the window." />
                        </local:SpacedPanel>
                        <TextBlock Text="&#x258D; WORKSPACE" Style="{StaticResource PanelTitle}" />
                    </DockPanel>
                    <Border x:Name="FolderEditsBanner" DockPanel.Dock="Top" BorderBrush="{StaticResource TagBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,8" Visibility="{Binding ShowFolderEdits, Converter={StaticResource BoolVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietIconButton}" Content="&#x21BA;" Command="{Binding ShowAllFoldersCommand}" ToolTip="Show all folders again. Nothing on disk was changed." />
                            <TextBlock Text="{Binding FolderEditsLabel}" Style="{StaticResource Readout}" Foreground="{StaticResource TagBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,6,0">
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,4" />
                        <Expander x:Name="CollectionsSection" Header="COLLECTIONS">
                            <local:SpacedPanel Orientation="Vertical" Margin="0,4,0,8">
                                <ItemsControl ItemsSource="{Binding Collections}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource ListRowButton}" Command="{Binding DataContext.OpenCollectionItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Show this collection in the workspace, beside your folders">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <DockPanel>
                                    <TextBlock Text="STAGE TO" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" Width="70" />
                                    <ComboBox x:Name="StageToBox" ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}" DisplayMemberPath="Name" AutomationProperties.Name="Staging collection" ToolTip="The collection that Stage (S) adds files to. Collections hold references; files stay where they are." />
                                </DockPanel>
                                <DockPanel x:Name="ManageCollectionsExpander">
                                    <Button DockPanel.Dock="Right" Content="+ NEW" Command="{Binding CreateCollectionCommand}" Margin="6,0,0,0" />
                                    <TextBox Text="{Binding CollectionName}" AutomationProperties.Name="New collection name" ToolTip="Name for a new collection" />
                                </DockPanel>
                                <Button Content="Remove current file from this collection" Command="{Binding RemoveFromCollectionCommand}" Visibility="{Binding IsCollectionView, Converter={StaticResource BoolVisibility}}" />
                            </local:SpacedPanel>
                        </Expander>
                        <Expander x:Name="TaggedFilesSection" Header="TAGS">
                            <local:SpacedPanel Orientation="Vertical" Margin="0,4,0,4">
                                <TextBox Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Filter by tag" ToolTip="Type a tag to narrow the filmstrip to files carrying it" />
                                <ComboBox ItemsSource="{Binding KnownTags}" SelectedItem="{Binding SelectedKnownTag}" AutomationProperties.Name="Known tags" ToolTip="Tags you have used" />
                                <Button Content="Show every tagged file" Command="{Binding BrowseTaggedCommand}" ToolTip="Every tagged file, from any folder or drive, as one more entry in the workspace" />
                            </local:SpacedPanel>
                        </Expander>
                    </StackPanel>
                    <Border x:Name="FolderTreePanel">
                        <ListBox x:Name="FolderTreeList" ItemsSource="{Binding FolderRows}" SelectedItem="{Binding SelectedFolderRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="FolderTreeKeyDown" MouseDoubleClick="FolderTreeDoubleClick" AutomationProperties.Name="Workspace folders">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource MediaListItem}"><Setter Property="Padding" Value="2,1" /><Setter Property="Margin" Value="0,0,6,1" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <!-- A context menu is outside the visual tree, so the window's view model is handed to it through Tag. -->
                                <DockPanel Height="26" Margin="{Binding Indent}" ToolTip="{Binding ToolTipText}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open in a new tab" Command="{Binding PlacementTarget.Tag.OpenInNewTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Add as a workspace folder of its own" Command="{Binding PlacementTarget.Tag.AddSubfolderToWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in Explorer" Command="{Binding PlacementTarget.Tag.RevealFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Tag this folder&#x2026;" Command="{Binding PlacementTarget.Tag.TagFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Tags that every file in this folder and its subfolders carries, including files added later" />
                                            <Separator />
                                            <MenuItem Header="Hide this folder (or remove a workspace folder)" Command="{Binding PlacementTarget.Tag.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Show all folders" Command="{Binding PlacementTarget.Tag.ShowAllFoldersCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <Border DockPanel.Dock="Left" Width="16" Background="Transparent" MouseLeftButtonDown="FolderToggleClicked" Cursor="Hand"><TextBlock Text="{Binding Glyph}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <!-- Album cover: the first and last picture in the folder, fetched once the row is scrolled into view. -->
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center" Loaded="FolderCoverLoaded">
                                        <Border Width="20" Height="20" Background="{StaticResource MonitorBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Visibility="{Binding HasCover, Converter={StaticResource BoolHidden}}"><Image Source="{Binding CoverFirst}" Stretch="UniformToFill" /></Border>
                                        <Border Width="20" Height="20" Background="{StaticResource MonitorBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="2,0,0,0" ClipToBounds="True" Visibility="{Binding HasSecondCover, Converter={StaticResource BoolHidden}}"><Image Source="{Binding CoverLast}" Stretch="UniformToFill" /></Border>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Readout}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,4,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="#" Style="{StaticResource Readout}" Foreground="{StaticResource TagBrush}" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding HasFolderTags, Converter={StaticResource BoolVisibility}}" ToolTip="This folder has tags; every file under it carries them" />
                                    <TextBlock DockPanel.Dock="Right" Text="&#x25CF;&#x25CF;&#x25CF;" FontSize="7" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding Folder.IsScanning, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}" ToolTip="{Binding Folder.State}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkspaceFolder}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsAllFolders}" Value="True"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </ContentControl>
            <GridSplitter x:Name="NavigatorSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize the workspace panel" />

            <Grid x:Name="CenterPanel" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <!-- One row: the views on the left, the selected file with its quick actions on the right. Fixed height. -->
                <Grid x:Name="CenterHeader" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" />
                    <StackPanel x:Name="MainTabs" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <RadioButton x:Name="LibraryTabButton" Content="OVERVIEW" GroupName="MainTabs" Style="{StaticResource MainTabButton}" IsChecked="{Binding IsLibraryTab}" ToolTip="Totals and a graph of the folder open in the filmstrip" />
                        <RadioButton x:Name="PreviewTabButton" Content="PREVIEW" GroupName="MainTabs" Style="{StaticResource MainTabButton}" IsChecked="{Binding IsPreviewTab}" ToolTip="The selected photo, video or audio file with its tools" />
                        <RadioButton x:Name="StitchTabButton" Content="STITCH" GroupName="MainTabs" Style="{StaticResource MainTabButton}" IsChecked="{Binding IsStitchTab}" ToolTip="Combine a few pictures into one: side by side, stacked or in a grid" />
                    </StackPanel>
                    <DockPanel x:Name="SelectionHeader" Grid.Column="1" Margin="16,0,0,4" VerticalAlignment="Center" Visibility="{Binding IsPreviewTab, Converter={StaticResource BoolVisibility}}">
                        <local:SpacedPanel DockPanel.Dock="Right" Margin="10,0,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolHidden}}">
                            <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Content="&#x2605;" Command="{Binding ToggleFavoriteCommand}" ToolTip="Favorite on or off (F)" AutomationProperties.Name="Favorite" />
                            <Button x:Name="StageButton" Content="STAGE" Command="{Binding StageSelectedCommand}" ToolTip="Add this file to the collection chosen under Stage to (S)" />
                            <Button x:Name="FocusViewButton" Style="{StaticResource IconButton}" Content="&#x26F6;" Command="{Binding ToggleFocusViewCommand}" ToolTip="Focus view: only the picture, the timeline and the buttons (F11)" AutomationProperties.Name="Focus view" />
                        </local:SpacedPanel>
                        <Border x:Name="AspectChip" DockPanel.Dock="Left" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="6,0" Margin="0,0,10,0" MinWidth="44" VerticalAlignment="Center" Visibility="{Binding HasAspectHighlight, Converter={StaticResource BoolHidden}}" ToolTip="The shape of this picture. A tilde means the exact ratio is only close to this everyday one; Details has the exact figure.">
                            <TextBlock Text="{Binding AspectHighlight}" Style="{StaticResource Readout}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource TagBrush}" BorderThickness="1" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsSelectionHidden, Converter={StaticResource BoolHidden}}" ToolTip="The open file is not in the folder or filters shown in the filmstrip. It stays open until you choose another file.">
                            <TextBlock Text="NOT IN VIEW" Style="{StaticResource Readout}" FontSize="11" Foreground="{StaticResource TagBrush}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedAsset.Asset.FullPath}"><Run Text="{Binding SelectionLabel, Mode=OneWay}" FontSize="14" /><Run Text="   " /><Run Text="{Binding HeaderSummary, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" /></TextBlock>
                    </DockPanel>
                </Grid>

                <!-- Overview: totals and a graph of the folder shown in the filmstrip. -->
                <Grid x:Name="LibraryTab" Grid.Row="1" Visibility="{Binding IsLibraryTab, Converter={StaticResource BoolVisibility}}">
                    <ContentControl Style="{StaticResource GlassPanel}" Visibility="{Binding ShowLibraryEmpty, Converter={StaticResource BoolVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
                            <TextBlock Text="{Binding EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="24" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,12,0,20" />
                            <local:SpacedPanel HorizontalAlignment="Center">
                                <Button Content="+ ADD A FOLDER" Command="{Binding OpenFolderCommand}" Style="{StaticResource AccentButton}" Visibility="{Binding ShowEmptyOpenFolder, Converter={StaticResource BoolVisibility}}" />
                                <Button Content="TOUR THE UI" Command="{Binding StartTourCommand}" Style="{StaticResource GhostButton}" />
                            </local:SpacedPanel>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl x:Name="FolderChartPanel" Style="{StaticResource GlassPanel}" Visibility="{Binding ShowLibraryMap, Converter={StaticResource BoolVisibility}}">
                        <DockPanel>
                            <StackPanel x:Name="LibrarySummaryBlock" DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="{Binding LibrarySummary}" FontFamily="{StaticResource DisplayFont}" FontSize="18" />
                                <TextBlock Text="{Binding LibraryKindSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" Style="{StaticResource PanelTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChartSubtitle}" Margin="0,0,0,6" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ToolTip="Bar length is the number of files, subfolders included; the percentage is that folder's share. Click a bar to open the folder.">
                                <local:FolderChart x:Name="FolderChartView" Nodes="{Binding ChartNodes}" SelectedPath="{Binding ChartSelectedPath, Mode=TwoWay}" CurrentPath="{Binding SelectedFolderRow.Node.Path, FallbackValue=''}" AutomationProperties.Name="Files per subfolder by media type" />
                            </ScrollViewer>
                        </DockPanel>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding Notifications}" ItemTemplate="{StaticResource NotificationTemplate}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="440" AutomationProperties.Name="Notifications" />
                </Grid>

                <!-- Preview: the selected file and its tools. The dock under the picture has the same height for a photo, a video and a
                     sound file, and nothing in it is added or removed when the file changes, so the picture never changes size. -->
                <Grid x:Name="PreviewTab" Grid.Row="1" Visibility="{Binding IsPreviewTab, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="PreviewMonitor" MouseWheel="FrameWheel" Background="{StaticResource MonitorBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <local:CropSurface x:Name="PreviewSurface" Source="{Binding PreviewImage}" LiveSource="{Binding LiveImage}" TopInset="{Binding FramingInset}" ViewKey="{Binding SelectedAsset}" Selection="{Binding CropSelection}" IsCropping="{Binding IsCropping}" EdgeSelection="{Binding VideoCrop}" IsEdgeEditing="{Binding ShowFramingTools}" Rotation="{Binding VideoRotation}" SelectedEdge="{Binding SelectedCropEdge}" />
                            <Border Background="#660B0A14" IsHitTestVisible="False" Visibility="{Binding IsPreviewStale, Converter={StaticResource BoolVisibility}}" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Background="#F2131A38" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" Padding="10,6" IsHitTestVisible="False" Visibility="{Binding ShowPendingOverlay, Converter={StaticResource BoolVisibility}}">
                                <StackPanel><TextBlock Text="{Binding PendingLabel}" Style="{StaticResource Readout}" /><ProgressBar Height="2" IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding EmptyTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="24" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,12,0,0" />
                                <Button Content="+ ADD A FOLDER" Command="{Binding OpenFolderCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="{Binding ShowEmptyOpenFolder, Converter={StaticResource BoolVisibility}}" />
                                <Button Content="CLEAR FILTERS" Command="{Binding ClearFiltersCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="{Binding ShowEmptyClearFilters, Converter={StaticResource BoolVisibility}}" />
                            </StackPanel>
                            <local:WaveformView x:Name="AudioWaveform" Margin="18" Visibility="{Binding ShowAudioStage, Converter={StaticResource BoolVisibility}}" Waveform="{Binding Waveform}" Duration="{Binding WaveformDuration}" Position="{Binding AudioPosition}" IsLive="{Binding ShowPlayback}" SelectionStart="{Binding AudioStart}" SelectionEnd="{Binding AudioEnd}" Message="{Binding WaveformMessage}" SelectionRequested="OnAudioSelectionRequested" SeekRequested="OnAudioSeekRequested" AutomationProperties.Name="Audio waveform" />
                            <!-- Stand-in picture: the thumbnail already in memory, shown at once while the file itself loads or while the filmstrip is scrolling. -->
                            <Grid x:Name="InstantLayer" Background="{StaticResource MonitorBrush}" IsHitTestVisible="False" Visibility="{Binding ShowInstantLayer, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="{Binding InstantGlyph}" FontSize="64" Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding InstantPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                            </Grid>
                            <ProgressBar Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Visibility="{Binding ShowFrameProgress, Converter={StaticResource BoolVisibility}}" />

                            <!-- Laid over the picture rather than added above or below it, so opening them never resizes anything. -->
                            <Border x:Name="FramingTools" VerticalAlignment="Top" Height="68" Background="#F2131A38" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="10,8" Visibility="{Binding ShowFramingTools, Converter={StaticResource BoolVisibility}}">
                                <DockPanel>
                                    <Button x:Name="ExportWholeVideoButton" DockPanel.Dock="Right" Content="EXPORT WHOLE VIDEO" Command="{Binding ExportWholeVideoCommand}" IsEnabled="{Binding HasVideoTransform}" Style="{StaticResource AccentButton}" Margin="10,0,0,0" VerticalAlignment="Top" ToolTip="Saves a new MP4 of the entire video with this crop and rotation. The original is not changed." />
                                    <local:SpacedPanel DockPanel.Dock="Top">
                                        <Button x:Name="AutoFitButton" Command="{Binding AutoFitCropCommand}" IsEnabled="{Binding CanAutoFit}" ToolTip="Finds black bars around the picture at several moments of the video and puts the four edges on the picture">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Content" Value="Auto-fit edges" /><Style.Triggers><DataTrigger Binding="{Binding IsAutoFitting}" Value="True"><Setter Property="Content" Value="Looking for borders&#x2026;" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button x:Name="RotateLeftButton" Content="&#x21BA; Turn left" Command="{Binding RotateVideoLeftCommand}" ToolTip="Turn the video a quarter turn anticlockwise" />
                                        <Button x:Name="RotateRightButton" Content="Turn right &#x21BB;" Command="{Binding RotateVideoRightCommand}" ToolTip="Turn the video a quarter turn clockwise" />
                                        <Button x:Name="ResetFramingButton" Content="Reset" Command="{Binding ResetVideoTransformCommand}" IsEnabled="{Binding HasVideoTransform}" ToolTip="Back to the whole frame, not turned" />
                                        <Button Content="Done" Style="{StaticResource GhostButton}" Command="{Binding ToggleFramingCommand}" ToolTip="Close these tools. The crop and rotation stay set for this video until you reset them or select another file." />
                                    </local:SpacedPanel>
                                    <TextBlock x:Name="FramingSummaryText" Text="{Binding FramingSummary}" Style="{StaticResource Readout}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding FramingEdgeHint}" />
                                </DockPanel>
                            </Border>
                            <Border x:Name="TransformReminder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#F2131A38" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="10,4" Visibility="{Binding ShowTransformReminder, Converter={StaticResource BoolVisibility}}">
                                <local:SpacedPanel Spacing="8">
                                    <TextBlock Text="{Binding FramingSummary}" Style="{StaticResource Readout}" FontSize="12" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="This crop and rotation apply to Export whole video and to Trim selection to MP4. Frame PNGs and Copy are not affected." />
                                    <Button Content="Export whole video" Command="{Binding ExportWholeVideoCommand}" />
                                    <Button Content="Reset" Command="{Binding ResetVideoTransformCommand}" />
                                </local:SpacedPanel>
                            </Border>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Background="#F2131A38" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" Padding="10,4" IsHitTestVisible="False" Visibility="{Binding IsCropping, Converter={StaticResource BoolVisibility}}">
                                <TextBlock x:Name="CropSizeText" Text="{Binding CropLabel}" Style="{StaticResource Readout}" FontSize="12" />
                            </Border>
                            <Button x:Name="ExitFocusButton" Content="EXIT FOCUS (F11)" Style="{StaticResource GhostButton}" Command="{Binding ToggleFocusViewCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="{Binding IsFocusView, Converter={StaticResource BoolVisibility}}" ToolTip="Brings back the panels, filters and filmstrip exactly as they were. Esc does the same." />
                            <ItemsControl ItemsSource="{Binding Notifications}" ItemTemplate="{StaticResource NotificationTemplate}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="440" AutomationProperties.Name="Notifications" />
                        </Grid>
                    </Border>

                    <!-- The dock: readout, timeline, sound, buttons. Fixed row heights; parts that do not apply to the file are hidden, never removed. -->
                    <Grid x:Name="PreviewDock" Grid.Row="1" Margin="0,6,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolHidden}}">
                        <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="50" /><RowDefinition Height="30" /><RowDefinition Height="36" /></Grid.RowDefinitions>
                        <!-- Readout. Every figure has a column of its own, so a longer number never pushes the next one along. -->
                        <Grid x:Name="FrameReadout" Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding FrameLabel}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="86" /><ColumnDefinition Width="84" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FrameNumberText}" Style="{StaticResource Readout}" FontSize="20" Foreground="{StaticResource AccentBrush}" TextAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="Current frame" />
                            <TextBlock Grid.Column="1" Text="{Binding FrameTotalText}" Style="{StaticResource Readout}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="6,0,0,3" />
                            <TextBlock Grid.Column="2" Text="{Binding FrameTimeText}" Style="{StaticResource Readout}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            <StackPanel x:Name="FrameRateReadout" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Background="Transparent" Visibility="{Binding HasFrameRate, Converter={StaticResource BoolHidden}}" ToolTip="{Binding FrameRateNote}">
                                <TextBlock Text="{Binding FrameRateText}" Style="{StaticResource Readout}" FontSize="20" VerticalAlignment="Bottom" AutomationProperties.Name="Frames per second" />
                                <TextBlock Text="{Binding FrameRateUnit}" Style="{StaticResource Readout}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                            </StackPanel>
                            <StackPanel x:Name="IndexingIndicator" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,3" Background="Transparent" Visibility="{Binding ShowIndexing, Converter={StaticResource BoolHidden}}" ToolTip="{Binding IndexingNote}" AutomationProperties.Name="{Binding IndexingText}" AutomationProperties.LiveSetting="Polite">
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource BorderBrush}"><Run Text="{Binding IndexDotsLead, Mode=OneWay}" /><Run Text="{Binding IndexDotsLit, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" /><Run Text="{Binding IndexDotsTail, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding IndexingText}" Style="{StaticResource Readout}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Text="{Binding RangeSummary}" Style="{StaticResource Readout}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" TextWrapping="NoWrap" Margin="8,0,0,3" />
                        </Grid>
                        <TextBlock x:Name="PhotoReadout" Text="{Binding HeaderSummary}" Style="{StaticResource Readout}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="2,0,0,3" Visibility="{Binding IsPhoto, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock x:Name="AudioSelectionReadout" Text="{Binding AudioSelectionText}" Style="{StaticResource Readout}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="2,0,0,3" Visibility="{Binding IsAudio, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding AudioHint}" />

                        <!-- Timeline with the in and out buttons at its ends, and the sound under it. -->
                        <Grid x:Name="VideoTimeline" Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}">
                            <Grid x:Name="TimelineArea" Background="Transparent" MouseWheel="FrameWheel">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                                <Button x:Name="MarkInButton" Content="[ IN" Command="{Binding MarkInCommand}" IsEnabled="{Binding HasFrames}" Width="64" ToolTip="Mark in (I): the selection starts at the current frame" VerticalAlignment="Top" Margin="0,4,8,0" />
                                <Button x:Name="MarkOutButton" Grid.Column="2" Content="OUT ]" Command="{Binding MarkOutCommand}" IsEnabled="{Binding HasFrames}" Width="64" ToolTip="Mark out (O): the selection ends at the current frame, inclusive" Margin="8,4,0,0" VerticalAlignment="Top" />
                                <local:FrameTimeline x:Name="Timeline" Grid.Column="1" Maximum="{Binding MaximumFrame}" Value="{Binding CurrentFrame, Mode=TwoWay}" InFrame="{Binding InFrame, Mode=TwoWay}" OutFrame="{Binding OutFrame, Mode=TwoWay}" Frames="{Binding FrameList}" DisplayedFrame="{Binding DisplayedFrame}" LivePosition="{Binding PlaybackFrame}" IsEnabled="{Binding HasFrames}" Height="48" AutomationProperties.Name="Exact frame position" ToolTip="Drag the playhead and the in and out handles. The mouse wheel steps frames; Left and Right step one frame, Shift ten." />
                                <local:WaveformView x:Name="VideoWaveform" Grid.Row="1" Grid.Column="1" Height="28" ShowRuler="False" Visibility="{Binding ShowVideoWaveform, Converter={StaticResource BoolHidden}}" Waveform="{Binding Waveform}" Duration="{Binding WaveformDuration}" Position="{Binding AudioPosition}" IsLive="{Binding ShowPlayback}" SelectionStart="{Binding AudioStart}" SelectionEnd="{Binding AudioEnd}" Message="{Binding WaveformMessage}" IsEnabled="{Binding HasFrames}" SelectionRequested="OnAudioSelectionRequested" SeekRequested="OnAudioSeekRequested" AutomationProperties.Name="Audio waveform" />
                                <TextBlock Grid.Row="1" Text="SOUND" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" HorizontalAlignment="Right" Margin="0,0,10,0" Visibility="{Binding ShowVideoWaveform, Converter={StaticResource BoolHidden}}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="No sound in this video" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowNoSoundNote, Converter={StaticResource BoolVisibility}}" />
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="{Binding AudioHint}" Style="{StaticResource Hint}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" Margin="40,0" Visibility="{Binding IsAudio, Converter={StaticResource BoolVisibility}}" />

                        <!-- Buttons: play controls on the left for video and sound, picture actions on the right; one row, one gap. -->
                        <DockPanel x:Name="ActionRow" Grid.Row="3" VerticalAlignment="Bottom" LastChildFill="False">
                            <local:SpacedPanel DockPanel.Dock="Right">
                                <Button x:Name="CopyButton" Content="COPY" Command="{Binding CopyPreviewCommand}" IsEnabled="{Binding CanCopy}" Visibility="{Binding IsVisual, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding CopyLabel}" />
                                <Button x:Name="CropButton" Command="{Binding ToggleCropCommand}" IsEnabled="{Binding CanCopy}" Visibility="{Binding IsVisual, Converter={StaticResource BoolVisibility}}" ToolTip="Drag on the picture to choose an area for Copy (C). Esc clears it.">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Content" Value="CROP" /><Style.Triggers><DataTrigger Binding="{Binding IsCropping}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button x:Name="ExportFrameButton" Content="{Binding ExportLabel}" Command="{Binding ExportFrameCommand}" IsEnabled="{Binding CanExportFrame}" Visibility="{Binding IsVisual, Converter={StaticResource BoolVisibility}}" Style="{StaticResource AccentButton}" MinWidth="112" ToolTip="{Binding ExportDestination}" />
                                <Button x:Name="MoreActionsButton" Content="MORE &#x25BE;" Click="MoreActionsClicked" ToolTip="Add to stitch, crop and rotate the whole video, snip the sound, clear the crop area">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="AddToStitchButton" Header="Add to stitch" Command="{Binding AddToStitchCommand}" IsEnabled="{Binding CanCopy}" ToolTip="Puts the picture on screen into the Stitch view, where a few pictures can be combined into one." />
                                            <MenuItem x:Name="FramingButton" Header="Crop and rotate the whole video&#x2026;" Command="{Binding ToggleFramingCommand}" IsEnabled="{Binding CanFrame}" IsChecked="{Binding IsFraming, Mode=OneWay}" Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}" ToolTip="Adjust four edges and turn the video in quarter turns, then export a new MP4" />
                                            <MenuItem x:Name="SnipAudioButton" Header="Snip marked sound to WAV" Command="{Binding ExportAudioCommand}" IsEnabled="{Binding CanSnipAudio}" Visibility="{Binding HasAudio, Converter={StaticResource BoolVisibility}}" ToolTip="Saves only the marked section of sound as a WAV file in the output folder. The original is not changed." />
                                            <MenuItem Header="Clear the crop area" Command="{Binding ResetCropCommand}" IsEnabled="{Binding HasCrop}" Visibility="{Binding IsVisual, Converter={StaticResource BoolVisibility}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </local:SpacedPanel>
                            <local:SpacedPanel x:Name="TransportControls" Visibility="{Binding CanPlay, Converter={StaticResource BoolHidden}}">
                                <Button x:Name="RestartButton" Style="{StaticResource IconButton}" Command="{Binding RestartCommand}" ToolTip="Restart: back to the first frame and play (Home)" AutomationProperties.Name="Restart">
                                    <!-- Drawn rather than a character: the "skip to start" symbol comes out boxed in the Windows emoji font. -->
                                    <Path Data="M 0,0 H 2 V 11 H 0 Z M 10,0 V 11 L 3,5.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="PreviousFrameButton" Style="{StaticResource IconButton}" Content="&#x25C0;" Command="{Binding PreviousFrameCommand}" IsEnabled="{Binding HasFrames}" ToolTip="Previous frame (comma, or Left in the preview)" AutomationProperties.Name="Previous frame" />
                                <Button x:Name="PlaybackButton" Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding CanPlay}" Width="92" ToolTip="Play or pause (Space). Play always starts on the frame you are looking at." AutomationProperties.Name="Play or pause">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AccentButton}"><Setter Property="Content" Value="&#x25B6; PLAY" /><Setter Property="Padding" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding ShowPlayback}" Value="True"><Setter Property="Content" Value="&#x275A;&#x275A; PAUSE" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button x:Name="NextFrameButton" Style="{StaticResource IconButton}" Content="&#x25B6;" Command="{Binding NextFrameCommand}" IsEnabled="{Binding HasFrames}" ToolTip="Next frame (period, or Right in the preview)" AutomationProperties.Name="Next frame" />
                                <Button x:Name="PlayRangeButton" Content="[&#x25B6;]" Command="{Binding PlaySelectionCommand}" IsEnabled="{Binding CanPlayRange}" Width="48" Padding="0" Margin="10,0,0,0" ToolTip="{Binding PlayRangeLabel}" AutomationProperties.Name="{Binding PlayRangeLabel}" />
                            </local:SpacedPanel>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Stitch: a few pictures combined into one. The list on the left is the order they are drawn in. -->
                <Grid x:Name="StitchTab" Grid.Row="1" Visibility="{Binding IsStitchTab, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource GlassPanel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="&#x258D; PICTURES TO COMBINE" Style="{StaticResource PanelTitle}" Margin="0,0,0,2" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding StitchCountLabel}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button x:Name="StitchMoveBackButton" Content="&#x25C0; Earlier" Command="{Binding MoveStitchItemCommand}" CommandParameter="back" ToolTip="Moves the chosen picture one place earlier in the order" />
                                <Button x:Name="StitchMoveForwardButton" Grid.Column="2" Content="Later &#x25B6;" Command="{Binding MoveStitchItemCommand}" CommandParameter="forward" ToolTip="Moves the chosen picture one place later in the order" />
                                <Button x:Name="StitchRemoveButton" Grid.Row="2" Content="Remove" Command="{Binding RemoveFromStitchCommand}" />
                                <Button x:Name="StitchClearButton" Grid.Row="2" Grid.Column="2" Content="Clear all" Command="{Binding ClearStitchCommand}" />
                            </Grid>
                            <ListBox x:Name="StitchList" ItemsSource="{Binding StitchItems}" SelectedItem="{Binding SelectedStitchItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pictures in the stitch">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <DockPanel ToolTip="{Binding ToolTipText}">
                                        <Border DockPanel.Dock="Left" Width="44" Height="32" Background="{StaticResource MonitorBrush}" Margin="0,0,8,0" ClipToBounds="True"><Image Source="{Binding Picture}" Stretch="Uniform" /></Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </ContentControl>
                    <DockPanel Grid.Column="2">
                        <ContentControl DockPanel.Dock="Top" Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,0,0,8">
                            <WrapPanel>
                                <local:SpacedPanel Margin="0,0,18,4">
                                    <TextBlock Text="ARRANGE" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="StitchArrangementBox" Width="140" ItemsSource="{Binding StitchArrangements}" SelectedItem="{Binding StitchArrangement}" AutomationProperties.Name="Arrangement" />
                                </local:SpacedPanel>
                                <local:SpacedPanel Margin="0,0,18,4" Visibility="{Binding IsGridStitch, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="COLUMNS" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" />
                                    <Slider x:Name="StitchColumnsSlider" Width="90" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding StitchColumns}" VerticalAlignment="Center" AutomationProperties.Name="Columns" />
                                    <TextBlock Text="{Binding StitchColumns}" Style="{StaticResource Readout}" VerticalAlignment="Center" Width="20" />
                                </local:SpacedPanel>
                                <local:SpacedPanel Margin="0,0,18,4">
                                    <TextBlock Text="GAP" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" />
                                    <Slider x:Name="StitchGapSlider" Width="90" Minimum="0" Maximum="120" Value="{Binding StitchGap}" VerticalAlignment="Center" AutomationProperties.Name="Gap between pictures" />
                                    <TextBlock Text="{Binding StitchGap}" Style="{StaticResource Readout}" VerticalAlignment="Center" Width="28" />
                                </local:SpacedPanel>
                                <CheckBox x:Name="StitchMatchBox" Content="Match sizes" IsChecked="{Binding StitchMatchSizes}" Margin="0,0,18,4" VerticalAlignment="Center" ToolTip="Scales the pictures so they line up. Nothing is ever enlarged; turn this off to keep every picture's own pixels." />
                                <local:SpacedPanel Margin="0,0,18,4">
                                    <TextBlock Text="BACKDROP" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="StitchBackdropBox" Width="120" ItemsSource="{Binding StitchBackdrops}" SelectedItem="{Binding StitchBackdrop}" AutomationProperties.Name="Backdrop colour" />
                                </local:SpacedPanel>
                                <CheckBox x:Name="StitchJpegBox" Content="Save as JPEG" IsChecked="{Binding StitchAsJpeg}" Margin="0,0,0,4" VerticalAlignment="Center" ToolTip="PNG keeps every pixel exactly and can be transparent; JPEG makes a much smaller file." />
                            </WrapPanel>
                        </ContentControl>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="StitchExportButton" DockPanel.Dock="Right" Content="{Binding StitchExportLabel}" Command="{Binding ExportStitchCommand}" IsEnabled="{Binding CanStitch}" Style="{StaticResource AccentButton}" Margin="10,0,0,0" ToolTip="{Binding ExportDestination}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Readout}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="Add pictures with More ▸ Add to stitch under the preview, or by right-clicking a file in the filmstrip.">
                                <Run Text="COMBINED SIZE" /><Run Text="  " /><Run Text="{Binding StitchSizeLabel, Mode=OneWay}" Foreground="{StaticResource InkBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Border Background="{StaticResource MonitorBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowStitchEmpty, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="NOTHING TO COMBINE YET" FontFamily="{StaticResource DisplayFont}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="Open a photo or pause a video on the frame you want, then More ▸ Add to stitch." Style="{StaticResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Image x:Name="StitchPreviewImage" Source="{Binding StitchPreview}" Stretch="Uniform" StretchDirection="DownOnly" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag to resize the inspector" />

            <!-- Inspector: facts, tags, exports and the advanced settings. -->
            <ContentControl x:Name="InspectorPanel" Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="10,4,4,10">
                <TabControl x:Name="InspectorTabs" SelectedIndex="{Binding InspectorTab}">
                    <TabItem Header="DETAILS">
                        <DockPanel x:Name="DetailsTabContent">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,10,8">
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="RevealFileButton" DockPanel.Dock="Right" Content="REVEAL" Command="{Binding RevealFileCommand}" IsEnabled="{Binding HasSelection}" ToolTip="Show the file in Windows Explorer" />
                                    <TextBlock Text="{Binding SelectedKindLabel}" Style="{StaticResource PanelTitle}" />
                                </DockPanel>
                                <TextBlock Text="{Binding MediaSummary}" Style="{StaticResource Readout}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <ScrollViewer x:Name="MetadataList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Metadata}" Margin="0,0,10,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#332A3A6E" BorderThickness="0,0,0,1" Padding="0,4">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanTag}" Margin="0,0,8,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Name}" Visibility="{Binding DataContext.IsMetadataTagMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" Margin="0,1,8,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="TAGS">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><local:SpacedPanel x:Name="TagsTabContent" Orientation="Vertical" Spacing="8" Margin="0,0,10,0">
                            <TextBlock Text="THIS FILE" Style="{StaticResource SectionTitle}" Margin="0,0,0,0" />
                            <DockPanel>
                                <Button x:Name="AddTagsButton" DockPanel.Dock="Right" Content="ADD" Command="{Binding AddTagsCommand}" IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                                <TextBox x:Name="TagBox" Text="{Binding TagText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Comma separated tags" ToolTip="Tags for this file, separated by commas. They are kept by the app and never written into the file; they follow the file when it is renamed or moved, and exact copies get them too." />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding SelectedTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource TagBrush}" BorderThickness="1" Padding="6,0,2,0" Margin="0,0,6,6" Height="24">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" Style="{StaticResource Readout}" Foreground="{StaticResource TagBrush}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource QuietIconButton}" Content="&#x2715;" Height="20" Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Remove this tag" /></StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                            <StackPanel x:Name="InheritedTagsSection" Visibility="{Binding HasInheritedTags, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="FROM FOLDERS" Style="{StaticResource SectionTitle}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding InheritedTags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                    <!-- Dashed: carried from a folder, so it is removed there, not here. -->
                                    <Grid Margin="0,0,6,6" Height="24" ToolTip="{Binding ToolTipText}">
                                        <Rectangle Stroke="{StaticResource TagBrush}" StrokeDashArray="3 2" StrokeThickness="1" SnapsToDevicePixels="True" />
                                        <TextBlock Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Readout}"><Run Text="{Binding Tag, Mode=OneWay}" Foreground="{StaticResource TagBrush}" /><Run Text=" &#x2190; " Foreground="{StaticResource FaintBrush}" /><Run Text="{Binding FolderName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="SuggestedTagsSection" Visibility="{Binding HasSuggestions, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="SUGGESTED" Style="{StaticResource SectionTitle}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding Suggestions}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,0" Margin="0,0,8,0" ToolTip="Add this tag to the file">
                                            <TextBlock><Run Text="+ " /><Run Text="{Binding Tag, Mode=OneWay}" /></TextBlock>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{Binding Files, Mode=OneWay}" /><Run Text=" tagged, " /><Run Text="{Binding Reason, Mode=OneWay}" /></TextBlock>
                                    </DockPanel>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>

                            <local:SpacedPanel Orientation="Vertical">
                                <Button x:Name="MetadataTagModeButton" Command="{Binding ToggleMetadataTagModeCommand}" IsEnabled="{Binding HasSelection}" ToolTip="Tick values in the Details tab to turn them into tags. Nothing is tagged until you confirm.">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Content" Value="Tag from details&#x2026;" /><Style.Triggers><DataTrigger Binding="{Binding IsMetadataTagMode}" Value="True"><Setter Property="Content" Value="Stop choosing" /><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button Content="Add ticked details as tags" Command="{Binding ConfirmMetadataTagsCommand}" IsEnabled="{Binding HasSelection}" Visibility="{Binding IsMetadataTagMode, Converter={StaticResource BoolVisibility}}" />
                                <Button x:Name="FindRelatedButton" Content="Find files with shared tags" Command="{Binding FindRelatedCommand}" IsEnabled="{Binding HasSelection}" ToolTip="Every other file, in any folder, that shares a tag with this one, as one more entry in the workspace" />
                            </local:SpacedPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,0" />
                            <StackPanel x:Name="FolderTagsSection">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderTagTarget}"><Run Text="FOLDER " /><Run Text="{Binding FolderTagTargetLabel, Mode=OneWay}" Foreground="{StaticResource InkBrush}" /></TextBlock>
                                <DockPanel IsEnabled="{Binding CanTagFolder}">
                                    <Button DockPanel.Dock="Right" Content="ADD" Command="{Binding AddFolderTagsCommand}" Margin="6,0,0,0" />
                                    <TextBox x:Name="FolderTagBox" Text="{Binding FolderTagText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Folder tags" ToolTip="Tags for the folder selected in the workspace tree. Every file in it and its subfolders carries them, including files added later." />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding FolderTagsOfTarget}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource TagBrush}" BorderThickness="1" Padding="6,0,2,0" Margin="0,0,6,6" Height="24">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="#" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBlock Text="{Binding}" Style="{StaticResource Readout}" Foreground="{StaticResource TagBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource QuietIconButton}" Content="&#x2715;" Height="20" Command="{Binding DataContext.RemoveFolderTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Remove this tag from the folder and every file in it" /></StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="Every file in this folder and its subfolders carries these tags, including files added later." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </local:SpacedPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding ExportBadge}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ExportTabContent" Margin="0,0,10,0">
                            <StackPanel x:Name="DestinationSection">
                                <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="CHANGE" Command="{Binding ChangeExportDirectoryCommand}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding ExportDestination}" Style="{StaticResource Readout}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ExportDestination}" />
                                </DockPanel>
                            </StackPanel>
                            <local:SpacedPanel x:Name="VideoExportPanel" Orientation="Vertical" Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="VIDEO SELECTION" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
                                <Grid ToolTip="Exact frame numbers, counted from zero, both included">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="IN" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding InFrame}" AutomationProperties.Name="In frame inclusive" />
                                    <TextBlock Grid.Column="3" Text="OUT" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="4" Text="{Binding OutFrame}" AutomationProperties.Name="Out frame inclusive" />
                                </Grid>
                                <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Hint}" />
                                <Button x:Name="TrimButton" Content="{Binding TrimLabel}" Command="{Binding TrimVideoCommand}" IsEnabled="{Binding HasFrames}" ToolTip="Frame-accurate H.264/AAC re-encode of the in/out range" />
                                <Grid x:Name="FrameExportButtons">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="{Binding SelectedFramesLabel}" Command="{Binding ExportSelectedFramesCommand}" IsEnabled="{Binding HasFrames}" ToolTip="One PNG per frame between the in and out markers" />
                                    <Button Grid.Column="2" Content="{Binding AllFramesLabel}" Command="{Binding ExportAllFramesCommand}" IsEnabled="{Binding HasFrames}" ToolTip="One PNG per decoded frame of the whole video" />
                                </Grid>
                            </local:SpacedPanel>
                            <local:SpacedPanel x:Name="AudioExportPanel" Orientation="Vertical" Visibility="{Binding HasAudio, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="SOUND" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
                                <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack}" DisplayMemberPath="Label" AutomationProperties.Name="Audio track" ToolTip="Which sound track to use" />
                                <ComboBox ItemsSource="{Binding AudioChannels}" SelectedIndex="{Binding SelectedChannelIndex}" AutomationProperties.Name="Audio channel" ToolTip="All channels, or one of them" />
                                <Grid ToolTip="Exact start and end in seconds; the end is not included">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="FROM" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding AudioStart, StringFormat=0.######}" AutomationProperties.Name="Audio start seconds" />
                                    <TextBlock Grid.Column="3" Text="TO" Style="{StaticResource PanelTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="4" Text="{Binding AudioEnd, StringFormat=0.######}" AutomationProperties.Name="Audio end seconds" />
                                </Grid>
                                <TextBlock Text="{Binding AudioSelectionText}" Style="{StaticResource Hint}" />
                                <Button Content="Export marked sound to WAV" Command="{Binding ExportAudioCommand}" />
                            </local:SpacedPanel>
                            <StackPanel x:Name="ExportQueueSection">
                                <TextBlock Text="QUEUE" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Nothing queued. Exports you start appear here with progress." Style="{StaticResource Hint}" Visibility="{Binding ShowQueueHint, Converter={StaticResource BoolVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Jobs}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8"><StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /><ProgressBar Value="{Binding Progress}" Height="3" Margin="0,8" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" MaxHeight="60" ToolTip="{Binding Status}" />
                                        <local:SpacedPanel Margin="0,8,0,0">
                                            <Button Content="Cancel" Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}" />
                                            <Button Content="Open output" Command="{Binding DataContext.OpenJobOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasOutput, Converter={StaticResource BoolVisibility}}" />
                                        </local:SpacedPanel>
                                    </StackPanel></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                            <Expander x:Name="JobHistoryExpander" Header="{Binding JobHistoryLabel}" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding JobHistory}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6"><DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Open" Command="{Binding DataContext.OpenHistoryOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding Succeeded, Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" />
                                        <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" /><TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Status, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding FinishedAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" /></TextBlock></StackPanel>
                                    </DockPanel></Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Expander>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="ADVANCED">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsTabContent" Margin="0,0,10,0">
                            <TextBlock Text="TOOLS" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <local:SpacedPanel Orientation="Vertical">
                                <StackPanel x:Name="FfmpegSetting"><TextBlock Text="FFmpeg bin folder (blank = PATH)" Style="{StaticResource Hint}" Margin="0,0,0,4" /><TextBox Text="{Binding FfmpegDirectory}" AutomationProperties.Name="FFmpeg bin folder" /></StackPanel>
                                <StackPanel x:Name="CacheSetting"><TextBlock Text="Disk cache limit (64-8192 MB)" Style="{StaticResource Hint}" Margin="0,0,0,4" /><TextBox Text="{Binding CacheMegabytes}" AutomationProperties.Name="Cache limit in megabytes" /></StackPanel>
                                <StackPanel><TextBlock Text="Output folder (typed path, used after Check tools and save)" Style="{StaticResource Hint}" Margin="0,0,0,4" /><TextBox x:Name="ExportDirectoryBox" Text="{Binding ExportDirectory}" AutomationProperties.Name="Default export folder" ToolTip="{Binding ExportDirectory}" /></StackPanel>
                                <Button x:Name="SaveSettingsButton" Content="Check tools and save" Command="{Binding SaveSettingsCommand}" />
                            </local:SpacedPanel>
                            <TextBlock Text="COLLECTION FILES" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Load JSON" Command="{Binding LoadCollectionJsonCommand}" ToolTip="Add a collection from a JSON file" />
                                <Button Grid.Column="2" Content="Save JSON" Command="{Binding ExportCollectionJsonCommand}" ToolTip="Save the chosen collection as a JSON file in the output folder" />
                            </Grid>
                            <Button x:Name="StageFilteredButton" Content="{Binding StageFilteredLabel}" Command="{Binding StageFilteredCommand}" Margin="0,6,0,0" ToolTip="Add every file that matches the current folder and filters to the chosen collection" />
                            <StackPanel x:Name="FavoritesTransferExpander">
                                <TextBlock Text="FAVORITES TRANSFER" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Content="Export favorites&#x2026;" Command="{Binding ExportFavoritesCommand}" ToolTip="Favorites of the folder shown in the filmstrip, as relative paths" />
                                    <Button Grid.Column="2" Content="Import favorites&#x2026;" Command="{Binding ImportFavoritesCommand}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="TagsMoreExpander">
                                <TextBlock Text="TAG RELATIONSHIPS" Style="{StaticResource SectionTitle}" />
                                <Button Content="Export tag relationships (JSON)" Command="{Binding ExportTagGraphCommand}" ToolTip="Every tag and the files that carry it. The file includes full paths." />
                            </StackPanel>
                            <TextBlock Text="KEYBOARD" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="KeyboardHelp" Style="{StaticResource Hint}" FontFamily="{StaticResource DisplayFont}" LineHeight="19" Text="F favorite · S stage · E export frame · C crop · Esc clear crop · Ctrl+C copy&#x0a;Space play/pause · Home restart · I/O in and out&#x0a;Left/Right: files in the filmstrip, frames in the preview&#x0a;, and . always step frames · Page Up/Down always change file&#x0a;F11 focus view" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </ContentControl>
        </Grid>

        <!-- Filmstrip, with the folder views open as tabs above it. -->
        <ContentControl x:Name="FilmstripPanel" Grid.Row="2" Style="{StaticResource GlassPanel}" Margin="8,0,8,0" Padding="8,6,8,4">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="26" Margin="0,0,0,4">
                    <local:SpacedPanel DockPanel.Dock="Right" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="VisibleCountText" Text="{Binding VisibleCount}" Style="{StaticResource Readout}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextAlignment="Right" Width="280" ToolTip="{Binding VisibleCount}" />
                        <StackPanel x:Name="ThumbnailSizeControl" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Thumbnail size"><TextBlock Text="&#x25A3;" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" /><Slider Width="90" Minimum="56" Maximum="168" Value="{Binding ThumbnailHeight}" AutomationProperties.Name="Thumbnail size" /></StackPanel>
                        <CheckBox x:Name="FollowScrollBox" Content="Follow scroll" IsChecked="{Binding FollowFilmstrip}" VerticalAlignment="Center" FontSize="11.5" ToolTip="Scroll the filmstrip and the preview shows the file under the marker straight away; it is opened fully when you stop scrolling." />
                    </local:SpacedPanel>
                    <Button x:Name="NewTabButton" DockPanel.Dock="Right" Style="{StaticResource QuietIconButton}" Content="+" FontSize="15" Command="{Binding NewTabCommand}" Margin="2,0,12,0" VerticalAlignment="Bottom" ToolTip="Open another folder tab. Tabs let you keep several folders a click away while you work." />
                    <ListBox x:Name="FolderTabsList" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" ItemContainerStyle="{StaticResource FolderTabItem}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" AutomationProperties.Name="Folder tabs" MouseUp="FolderTabMouseUp">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Readout}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Readout}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,2,0" />
                                <Button Style="{StaticResource QuietIconButton}" Content="&#x2715;" FontSize="10" Width="18" Height="18" MinWidth="18" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanCloseTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" ToolTip="Close this tab (middle-click also closes it)" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Filmstrip" Height="{Binding FilmstripHeight}" ItemsSource="{Binding LibraryView}"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" VirtualizingPanel.CacheLengthUnit="Page"
                             PreviewMouseWheel="FilmstripMouseWheel" PreviewMouseDown="FilmstripMouseDown" ScrollViewer.ScrollChanged="FilmstripScrollChanged" SizeChanged="FilmstripSizeChanged" SelectionChanged="FilmstripSelectionChanged" AutomationProperties.Name="Media filmstrip">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource MediaListItem}"><Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="3" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Width="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Details}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add to stitch" Command="{Binding PlacementTarget.Tag.AddToStitchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" ToolTip="Adds this file's picture to the Stitch view." />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Grid Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=Window}}" Background="{StaticResource MonitorBrush}">
                                    <TextBlock Text="{Binding Placeholder}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BorderBrush}" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" DataContextChanged="ThumbnailContextChanged" />
                                    <TextBlock Text="{Binding FavoriteLabel}" Foreground="{StaticResource AccentAltBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,4,0" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVisibility}}" />
                                    <!-- Photo, video or sound, without having to read the file name. -->
                                    <Border Background="#D004060E" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2" Padding="4,1" ToolTip="{Binding KindLabel}"><TextBlock Text="{Binding KindGlyph}" Foreground="{Binding KindBrush}" FontSize="10" /></Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11.5" Margin="0,4,0,0" ToolTip="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Where the preview looks while "Follow scroll" is on. It slides to the edges near either end so the first and last files can be reached. -->
                    <Canvas x:Name="FollowMarker" IsHitTestVisible="False" ClipToBounds="True" Visibility="{Binding FollowFilmstrip, Converter={StaticResource BoolVisibility}}">
                        <Path x:Name="FollowMarkerShape" Fill="{StaticResource AccentBrush}" Data="M -6,0 L 6,0 L 1,7 L 1,2000 L -1,2000 L -1,7 Z" Opacity="0.9" />
                    </Canvas>
                </Grid>
            </DockPanel>
        </ContentControl>

        <DockPanel x:Name="StatusRow" Grid.Row="3" Margin="14,0">
            <TextBlock DockPanel.Dock="Right" Text="READING FOLDERS" Style="{StaticResource Readout}" FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" />
            <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Readout}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Tour the UI: dims the window, outlines one control at a time and explains it. -->
        <Canvas x:Name="TourLayer" Grid.RowSpan="4" Visibility="Collapsed" Background="Transparent" ClipToBounds="True">
            <Path x:Name="TourDim" Fill="#B3000000" />
            <Border x:Name="TourHighlight" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" IsHitTestVisible="False" />
            <Border x:Name="TourCallout" Width="380" Background="{StaticResource PanelSolidBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="16,14">
                <StackPanel>
                    <TextBlock x:Name="TourStepCount" Style="{StaticResource Readout}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="TourTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,6" />
                    <TextBlock x:Name="TourBody" TextWrapping="Wrap" LineHeight="20" />
                    <TextBlock x:Name="TourNote" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <Button Content="End tour" Click="TourEndClicked" ToolTip="Esc" />
                        <local:SpacedPanel HorizontalAlignment="Right">
                            <Button x:Name="TourBackButton" Content="Back" Click="TourBackClicked" ToolTip="Left arrow" />
                            <Button x:Name="TourNextButton" Content="Next" Click="TourNextClicked" Style="{StaticResource AccentButton}" ToolTip="Right arrow or Enter" />
                        </local:SpacedPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
