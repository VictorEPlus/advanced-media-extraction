<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests of the Avalonia app: the real view model and window, real FFmpeg and VLC, no window on screen. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MediaWorkbench.Avalonia/MediaWorkbench.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- VLC's native files, copied next to the tests so playback can be checked too. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <Using Include="Xunit" />
    <!-- The WPF on-screen checks, copied in and half adapted (about 40 compile errors left); see docs/AVALONIA-HANDOFF.md. -->
    <Compile Remove="DesktopChecks/**" />
    <None Include="DesktopChecks/**" />
  </ItemGroup>
</Project>
